{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "types": ["node"],
    "lib": ["ESNext"],
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*"]
}